# Optional fallback connection, used when no connection is configured in the UI.
# Use the READ-ONLY user created with scripts/create_readonly_user.sql.
# SSL options can be appended, e.g. ?sslmode=verify-full&sslrootcert=/certs/ca.pem
DATABASE_URL=postgresql://dbviewer_readonly:CHANGE_ME@your-db-host:5432/your_database

# Maximum rows returned to the browser (larger results are truncated).
MAX_ROWS=5000

# Queries running longer than this are cancelled by PostgreSQL (milliseconds).
STATEMENT_TIMEOUT_MS=30000
